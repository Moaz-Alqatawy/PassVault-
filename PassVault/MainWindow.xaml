<Window x:Class="PassVault.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PassVault" Height="760" Width="1180" MinHeight="600" MinWidth="860"
        WindowStartupLocation="CenterScreen" PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseDown="Window_PreviewMouseDown" PreviewMouseMove="Window_PreviewMouseMove">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="White" BorderBrush="#E6EAF1" BorderThickness="0,0,0,1">
            <Grid Margin="24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#EEF1FF" CornerRadius="14" Width="46" Height="46">
                        <TextBlock Text="🔐" FontSize="23" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="PassVault" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="خزنتك الشخصية على هذا الجهاز" Foreground="{StaticResource MutedBrush}" FontSize="12"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="⚙ الإعدادات" Click="Settings_Click"/>
                    <Button Content="قفل 🔒" Click="Lock_Click" Background="#FFF1E9"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="White" CornerRadius="16" Padding="16" Margin="0,0,14,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="تطبيقاتي" FontSize="18" FontWeight="SemiBold" Margin="4,2,4,10"/>
                        <Button Content="＋ إضافة تطبيق" HorizontalContentAlignment="Center"
                                Background="{StaticResource PrimaryBrush}" Foreground="White" Click="AddApplication_Click"/>
                        <Button Content="حذف التطبيق المحدد" HorizontalContentAlignment="Center"
                                Background="#FFF0EF" Foreground="#A33B37" Click="DeleteApplication_Click"/>
                    </StackPanel>
                    <ListBox x:Name="ApplicationsList" Margin="0,12,0,0" BorderThickness="0"
                             Background="Transparent" SelectionChanged="ApplicationsList_SelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="10,12"/>
                                <Setter Property="Margin" Value="0,2"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#EEF1FF"/>
                                                    <Setter Property="Foreground" Value="#344DB2"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="#F3F5FA"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel>
                                    <TextBlock Text="{Binding Icon}" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding Name}" FontSize="14" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="White" CornerRadius="16" Padding="22">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock x:Name="SelectedApplicationName" Text="كل الحسابات" FontSize="24" FontWeight="SemiBold"/>
                            <TextBlock x:Name="AccountsSummary" Text="اختر تطبيقًا أو أضف حسابًا جديدًا"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="＋ حساب جديد" Background="{StaticResource PrimaryBrush}"
                                Foreground="White" Click="AddAccount_Click"/>
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,16,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox" MinWidth="180" ToolTip="ابحث بالاسم أو المستخدم أو البريد"
                                 TextChanged="SearchBox_TextChanged"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="✎ تعديل" Click="EditAccount_Click"/>
                            <Button Content="حذف" Background="#FFF0EF" Foreground="#A33B37" Click="DeleteAccount_Click"/>
                        </StackPanel>
                    </Grid>
                    <Grid Grid.Row="2">
                        <DataGrid x:Name="AccountsGrid" SelectionMode="Single" SelectionUnit="FullRow">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="الاسم" Binding="{Binding Name}" Width="1.1*"/>
                                <DataGridTextColumn Header="اسم المستخدم" Binding="{Binding Username}" Width="1.1*"/>
                                <DataGridTextColumn Header="الهاتف" Binding="{Binding Phone}" Width="1*"/>
                                <DataGridTextColumn Header="البريد الإلكتروني" Binding="{Binding Email}" Width="1.4*"/>
                                <DataGridTextColumn x:Name="PasswordColumn" Header="كلمة المرور" Binding="{Binding PasswordDisplay}" Width="1*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                            <TextBlock Text="🗂️" FontSize="42" HorizontalAlignment="Center"/>
                            <TextBlock Text="لا توجد حسابات هنا بعد" FontSize="17" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,10,0,3"/>
                            <TextBlock Text="أضف حسابك الأول ليبقى محفوظًا ومشفّرًا على جهازك."
                                       Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="3" Background="#F8F9FC" CornerRadius="10" Padding="8" Margin="0,12,0,0">
                        <DockPanel>
                            <TextBlock x:Name="StatusText" Text="بياناتك مشفّرة ومحفوظة محليًا 🔒"
                                       Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" Margin="8,0"/>
                            <WrapPanel DockPanel.Dock="Left" Orientation="Horizontal">
                                <Button Content="نسخ كلمة المرور" Click="CopyPassword_Click"/>
                                <Button Content="نسخ البريد" Click="CopyEmail_Click"/>
                                <Button Content="نسخ المستخدم" Click="CopyUsername_Click"/>
                                <Button Content="نسخ حقل آخر" Click="CopyOtherField_Click"/>
                                <Button Content="إظهار كلمات المرور" Click="TogglePasswords_Click"/>
                            </WrapPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
